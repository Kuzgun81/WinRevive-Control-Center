<Window x:Class="WinRevive.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinRevive ilk açılış"
        Width="620" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="WinRevive'e hoş geldiniz" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Bu sihirbaz yerel tercihleri ayarlar. Sistem değişikliği yapmadan önce her işlem açıklanır ve snapshot alınır."
                 Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,20"/>
      <TextBlock Text="Arayüz teması" FontWeight="SemiBold"/>
      <ComboBox SelectedValue="{Binding Theme}" ItemsSource="{Binding Themes}" DisplayMemberPath="Name"
                SelectedValuePath="Value" Padding="8" Margin="0,8,0,18"/>
      <TextBlock Text="Başlangıç profili" FontWeight="SemiBold"/>
      <ComboBox SelectedValue="{Binding PreferredProfile}" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                SelectedValuePath="Value" Padding="8" Margin="0,8,0,18"/>
      <TextBlock Text="Önerilen profil yalnızca tercih olarak kaydedilir; bu sihirbaz otomatik sistem değişikliği uygulamaz."
                 Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Devam et" Click="ContinueClick"/>
    </StackPanel>
  </Grid>
</Window>
