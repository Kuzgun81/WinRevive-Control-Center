<Window x:Class="WinRevive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinRevive Control Center"
        Width="1180" Height="780" MinWidth="980" MinHeight="640"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="WinRevive Control Center" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Güvenli, ölçülebilir ve geri alınabilir Windows yönetimi"
                   Foreground="{DynamicResource MutedText}" Margin="0,5,0,0"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                 Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
    </DockPanel>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
      <TabItem Header="Dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,18,12,0">
            <TextBlock Text="Sistem özeti" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <UniformGrid Columns="2">
              <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Windows" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding SystemInfo.WindowsVersion}" FontSize="18" Margin="0,7,0,0"/></StackPanel>
              </Border>
              <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="İşlemci" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding SystemInfo.Processor}" FontSize="18" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
              </Border>
              <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="Bellek" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding SystemInfo.Memory}" FontSize="18" Margin="0,7,0,0"/></StackPanel>
              </Border>
              <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18">
                <StackPanel><TextBlock Text="Sistem diski" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding SystemInfo.Disk}" FontSize="18" Margin="0,7,0,0"/></StackPanel>
              </Border>
            </UniformGrid>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Platform ve capability" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SystemInfo.Architecture}" Foreground="{DynamicResource MutedText}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SystemInfo.LogicalProcessors}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SystemInfo.Capabilities}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Salt-okunur Windows analizi" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SystemInfo.StartupSummary}" Foreground="{DynamicResource MutedText}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SystemInfo.SearchSummary}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SystemInfo.Graphics}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SystemInfo.Battery}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SystemInfo.Pagefile}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SystemInfo.Security}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SystemInfo.Applications}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Button Content="Sistemi yeniden tara" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Güvenli Profiller">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,18,12,0">
            <TextBlock Text="Geri alınabilir Windows profilleri" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Her profil önce mevcut değerleri snapshot olarak kaydeder, sonra uygular ve gerçek sistemi doğrular."
                       Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14"/>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Linux-benzeri minimal profil" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="Koyu tema, azaltılmış şeffaflık ve sol görev çubuğu hizası. Windows dosyaları, servisler ve güvenlik ayarları değiştirilmez."
                             Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,12,0"/>
                  <TextBlock Text="{Binding MinimalProfileState}" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button Content="Profili uygula" Command="{Binding ApplyMinimalProfileCommand}"/>
                  <Button Content="Profili geri al" Command="{Binding RevertMinimalProfileCommand}" Background="#CBD5E1"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Şeffaflığı azalt" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="Yalnızca HKCU kişiselleştirme değerini değiştirir ve önceki değeri yedekler."
                             Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,12,0"/>
                  <TextBlock Text="{Binding TransparencyState}" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button Content="Uygula" Command="{Binding ApplyTransparencyCommand}"/>
                  <Button Content="Geri al" Command="{Binding RevertTransparencyCommand}" Background="#CBD5E1"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Optimizasyon">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,18,12,0">
            <TextBlock Text="Ölçülü optimizasyon profilleri" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Profiller sabit ve açıklanmış Windows işlemleri kullanır. Serbest PowerShell veya keyfi komut çalıştırılmaz."
                       Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14"/>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18">
              <StackPanel>
                <TextBlock Text="Genel / dengeli" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Windows dengeli güç planını etkinleştirir." Foreground="{DynamicResource MutedText}" Margin="0,6,0,0"/>
                <Button Content="Uygula" Command="{Binding ApplyGeneralProfileCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Oyun / performans" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Windows yüksek performans planını etkinleştirir; donanım üreticisi sürücülerini değiştirmez." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Button Content="Uygula" Command="{Binding ApplyGamingProfileCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Pil / verimlilik" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Windows güç tasarrufu planını etkinleştirir." Foreground="{DynamicResource MutedText}" Margin="0,6,0,0"/>
                <Button Content="Uygula" Command="{Binding ApplyBatteryProfileCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Düşük donanım" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Geri alınabilir minimal görünüm profilini uygular; Windows sistem dosyalarını veya güvenlik ayarlarını değiştirmez." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Button Content="Uygula" Command="{Binding ApplyLowHardwareProfileCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Sistem Analizi">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,18,12,0">
            <TextBlock Text="Windows entegrasyon durumu" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Bu sürümde yalnızca gerçek ve doğrulanabilir salt-okunur analizler gösterilir."
                       Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14"/>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18">
              <StackPanel>
                <TextBlock Text="{Binding SystemInfo.WindowsVersion}" FontSize="18"/>
                <TextBlock Text="{Binding SystemInfo.Capabilities}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SystemInfo.StartupSummary}" Foreground="{DynamicResource MutedText}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SystemInfo.SearchSummary}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Başlangıç / Search">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,18,12,0">
            <TextBlock Text="Başlangıç ve Windows Search yönetimi" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Yalnızca kullanıcı kapsamındaki Run/RunOnce girdileri değiştirilebilir. Bilgisayar kapsamı salt-okunur kalır."
                       Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14"/>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="Başlangıç girdileri" FontSize="16" FontWeight="SemiBold"/>
                  <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshStartupCommand}"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding StartupEntries}" SelectedItem="{Binding SelectedStartup}" Margin="0,10,0,0" MaxHeight="220"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Seçileni devre dışı bırak" Command="{Binding DisableSelectedStartupCommand}"/>
                  <Button Content="Son değişikliği geri al" Command="{Binding RevertStartupCommand}" Background="#CBD5E1"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Windows Search" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SystemInfo.SearchSummary}" Foreground="{DynamicResource MutedText}" Margin="0,6,0,0"/>
                <TextBlock Text="Onarım servisi durdurup yeniden başlatır; yönetici yetkisi gerekebilir." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Button Content="Search servisini onar / yeniden başlat" Command="{Binding RepairSearchCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="İşlem Geçmişi">
        <StackPanel Margin="0,18,12,0">
          <TextBlock Text="Apply / Verify / Revert geçmişi" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding LastOperation}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <ListBox ItemsSource="{Binding RecentOperations}" Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource PrimaryText}" Margin="0,12,0,0"/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Ayarlar">
        <StackPanel Margin="0,18,12,0">
          <TextBlock Text="Arayüz ayarları" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="Yerel ayarlar kullanıcı profilinde saklanır." Foreground="{DynamicResource MutedText}" Margin="0,6,0,14"/>
          <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="18">
            <StackPanel>
              <TextBlock Text="Tema" FontSize="16" FontWeight="SemiBold"/>
              <ComboBox SelectedValue="{Binding Theme}" ItemsSource="{Binding Themes}" DisplayMemberPath="Name"
                        SelectedValuePath="Value" Padding="8" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Text="WinRevive • Değişiklikler açıklanır, doğrulanır ve geri alınabilir."
               Foreground="{DynamicResource MutedText}" Margin="0,18,0,0"/>
  </Grid>
</Window>
